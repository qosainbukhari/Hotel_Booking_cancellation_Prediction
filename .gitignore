
# Data, outputs and logs (never in Git)
# Raw data is versioned with DVC: Git keeps only the small .dvc pointer files.
/data/*
!/data/raw/
/data/raw/*
!/data/raw/*.dvc
!/data/raw/.gitignore
artifacts/
mlruns/
logs/
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
